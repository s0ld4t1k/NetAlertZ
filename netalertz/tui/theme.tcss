/* NetAlertZ terminal theme — custom layout, no inherited web UI. */

Screen {
    background: $background;
    color: $foreground;
}

#app-shell {
    layout: vertical;
    height: 100%;
}

/* ------------------------------------------------------------------ top bar */
TopBar {
    height: 3;
    background: $panel;
    border-bottom: solid $primary 25%;
    padding: 0 1;
}

#top-brand {
    width: auto;
    height: 2;
    padding: 0 2 0 1;
    color: $primary;
    text-style: bold;
    content-align: left top;
}

#top-title-block {
    width: 1fr;
    height: 2;
    padding: 0 2;
    content-align: left middle;
}

#top-view {
    height: 1;
    text-style: bold;
    color: $foreground;
}

#top-sub {
    height: 1;
    color: $text-muted;
    text-style: italic;
}

#top-spacer {
    display: none;
}

#top-meta {
    width: 38;
    height: 2;
    padding: 0 2;
    content-align: right middle;
}

#top-network {
    height: 1;
    color: $success;
    content-align: right middle;
}

#top-scan {
    height: 1;
    color: $text-muted;
    content-align: right middle;
}

#top-clock-block {
    width: 12;
    height: 2;
    padding: 0 1;
    content-align: right middle;
}

#top-clock {
    height: 1;
    color: $accent;
    text-style: bold;
    content-align: right middle;
}

#top-date {
    height: 1;
    color: $text-muted;
    content-align: right middle;
}

/* ------------------------------------------------------------------- sidebar */
#main {
    height: 1fr;
}

Sidebar {
    width: 26;
    height: 1fr;
    background: $panel;
    border-right: solid $primary 20%;
    padding: 0 1;
}

.side-heading {
    height: 1;
    margin-top: 1;
    padding: 0 1;
    color: $text-muted;
    text-style: bold;
}

NavItem {
    height: 1;
    padding: 0 1;
}

NavItem:hover {
    background: $boost;
}

NavItem.active {
    background: $primary 18%;
}

.nav-label {
    width: 1fr;
    height: 1;
    color: $foreground;
}

NavItem.active .nav-label {
    color: $primary;
    text-style: bold;
}

.nav-count {
    width: 4;
    height: 1;
    color: $text-muted;
    content-align: right middle;
}

.nav-count.alert {
    color: $error;
    text-style: bold;
}

#sidebar-spacer {
    height: 1fr;
}

#sidebar-status {
    height: auto;
    padding: 1 1;
    margin: 1 0 0 0;
    background: $boost 30%;
    border-top: solid $primary 15%;
    color: $text-muted;
}

/* -------------------------------------------------------------------- shell */
#content {
    width: 1fr;
    height: 1fr;
}

.view {
    height: 1fr;
    padding: 1 2;
}

.panel {
    height: 1fr;
    background: $surface;
    border: round $primary 25%;
    padding: 0 1;
}

.panel-title {
    height: 1;
    color: $text-muted;
    background: transparent;
}

.panel DataTable {
    height: 1fr;
    background: transparent;
}

/* --------------------------------------------------------------------- KPIs */
#stat-row, #presence-stats, #scanner-stats {
    height: 7;
    margin: 1 0;
}

StatCard {
    width: 1fr;
    height: 7;
    margin-right: 1;
    padding: 0 1;
    background: $surface;
    border: round $primary 25%;
}

StatCard:last-of-type {
    margin-right: 0;
}

.stat-label {
    height: 1;
    color: $text-muted;
    text-style: bold;
}

.stat-value {
    height: 3;
    color: $primary;
    text-style: bold;
    content-align: left middle;
}

.stat-note {
    height: 1;
    color: $text-muted;
    text-style: italic;
}

.tone-success { border: round $success 45%; }
.tone-success .stat-value { color: $success; }
.tone-error { border: round $error 45%; }
.tone-error .stat-value { color: $error; }
.tone-warning { border: round $warning 45%; }
.tone-warning .stat-value { color: $warning; }
.tone-secondary { border: round $secondary 45%; }
.tone-secondary .stat-value { color: $secondary; }
.tone-muted .stat-value { color: $text-muted; }

/* ------------------------------------------------------------------- toolbar */
.toolbar {
    height: 3;
    align: left middle;
}

.toolbar.slim {
    height: 3;
}

.toolbar-title {
    width: 1fr;
    height: 3;
    content-align: left middle;
    color: $foreground;
}

.toolbar Button {
    margin-left: 1;
    min-width: 9;
    height: 3;
}

.toolbar Select {
    width: 27;
    margin-left: 1;
}

.search-input {
    width: 1fr;
}

.subhead {
    height: 1;
    margin-bottom: 1;
}

.count-label {
    width: auto;
    height: 1;
    color: $foreground;
}

.hint {
    width: 1fr;
    height: 1;
    color: $text-muted;
    content-align: right middle;
}

/* ---------------------------------------------------------------- data table */
DataTable {
    height: 1fr;
    background: $surface;
}

DataTable > .datatable--header {
    background: $boost;
    color: $primary;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $primary 28%;
    color: $foreground;
}

DataTable > .datatable--even-row {
    background: $surface;
}

DataTable > .datatable--odd-row {
    background: $panel;
}

DataTable > .datatable--hover {
    background: $boost 60%;
}

/* -------------------------------------------------------------- responsive */
#app-shell.short #dash-head {
    height: 3;
}

#app-shell.short #stat-row {
    height: 6;
    margin: 0;
}

#app-shell.short #stat-row StatCard {
    height: 6;
}

#app-shell.short #stat-row .stat-value {
    height: 2;
}

#app-shell.short #dash-mid {
    height: 9;
    margin-bottom: 0;
}

/* Very narrow terminals: drop the clock and tighten the metadata block. */
#app-shell.micro #top-clock-block {
    display: none;
}

#app-shell.micro #top-meta {
    width: 26;
}

#app-shell.tiny Sidebar {
    width: 6;
    padding: 0;
}

#app-shell.tiny .side-heading,
#app-shell.tiny .nav-count,
#app-shell.tiny #sidebar-status {
    display: none;
}

#app-shell.tiny NavItem {
    padding: 0 1;
}

#app-shell.tiny .nav-label {
    width: 1fr;
    content-align: center middle;
}

#app-shell.narrow #network-body {
    layout: vertical;
}

#app-shell.narrow #tree-panel {
    width: 1fr;
    margin-right: 0;
    margin-bottom: 1;
}

#app-shell.narrow #network-detail-panel {
    width: 1fr;
    height: 10;
}

#app-shell.tiny #network-detail-panel {
    display: none;
}

/* ----------------------------------------------------------------- dashboard */
#dash-head {
    height: 4;
}

#dash-head-text {
    width: 1fr;
    height: 4;
    content-align: left middle;
}

#dash-headline {
    height: 2;
    text-style: bold;
    color: $foreground;
    content-align: left middle;
}

#dash-summary {
    height: 1;
    color: $text-muted;
}

#dash-scan {
    height: 3;
    margin: 0 0 0 2;
    min-width: 16;
}

#dash-mid {
    height: 11;
    margin-bottom: 1;
}

#presence-panel {
    width: 2fr;
    margin-right: 1;
}

#scan-panel {
    width: 2fr;
}

#presence-spark {
    height: 2;
    margin: 1 1 0 1;
    color: $primary;
}

#presence-meta {
    height: 1;
    padding: 0 1;
}

#presence-legend {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#dash-bottom {
    height: 1fr;
}

#activity-panel {
    width: 3fr;
    margin-right: 1;
}

#attention-panel {
    width: 2fr;
}

/* ------------------------------------------------------------------ presence */
#presence-table {
    background: $surface;
}

/* ------------------------------------------------------------------- network */
#network-body {
    height: 1fr;
}

#tree-panel {
    width: 2fr;
    margin-right: 1;
}

#network-detail-panel {
    width: 46;
}

Tree {
    height: 1fr;
    background: transparent;
    padding: 0 1;
}

Tree > .tree--cursor {
    background: $primary 25%;
}

Tree > .tree--guides {
    color: $primary 25%;
}

Tree > .tree--highlight-line {
    background: $boost 40%;
}

/* ------------------------------------------------------------------ scanners */
#scanner-body {
    height: 1fr;
}

#scan-history-panel {
    width: 2fr;
    margin-right: 1;
}

#scanner-config-panel {
    width: 1fr;
}

#scanner-config {
    height: 1fr;
    padding: 1 1;
}

/* ----------------------------------------------------------------- settings */
#settings-body {
    height: 1fr;
}

#settings-table-panel {
    width: 2fr;
    margin-right: 1;
}

#settings-info-panel {
    width: 42;
}

#setting-info {
    height: 1fr;
    padding: 1 1;
}

#setting-desc {
    height: 2;
    padding: 0 1;
    color: $text-muted;
}

/* --------------------------------------------------------------------- logs */
#log-output {
    height: 1fr;
    background: $panel;
    border: round $primary 20%;
    padding: 0 1;
}

/* --------------------------------------------------------------------- help */
#help-scroll {
    height: 1fr;
    background: $surface;
    border: round $primary 20%;
}

#help-body {
    height: auto;
    padding: 1 2;
}

/* -------------------------------------------------------------------- modal */
BaseModal, ConfirmModal, PromptModal, NewDeviceModal, EditDeviceModal, EditSettingModal, NewWorkflowModal {
    align: center middle;
    background: $background;
}

#modal-card {
    height: auto;
    max-height: 92%;
    background: $surface;
    border: thick $primary 45%;
    padding: 1 2;
}

.w62 { width: 62; }
.w64 { width: 64; }
.w72 { width: 72; }
.w76 { width: 76; }
.w82 { width: 82; }
.w88 { width: 88; }

.modal-title {
    height: 1;
    color: $primary;
    text-style: bold;
}

.modal-sub {
    height: 1;
    color: $text-muted;
    margin-bottom: 1;
}

#modal-body {
    height: auto;
    max-height: 26;
    padding: 1 0 0 0;
}

.modal-text {
    height: auto;
    padding: 1 0;
}

.modal-actions {
    height: 3;
    margin-top: 1;
    align: right middle;
}

.modal-actions Button {
    margin-left: 1;
    min-width: 12;
}

.form-row {
    height: auto;
    min-height: 3;
    margin-bottom: 1;
    align: left middle;
}

.form-label-col {
    width: 22;
    height: auto;
}

.field-label {
    height: 1;
    color: $foreground;
    text-style: bold;
}

.field-hint {
    height: auto;
    color: $text-muted;
    text-style: italic;
}

.form-row Input {
    width: 1fr;
}

.form-row Select {
    width: 1fr;
}

.switch-row {
    height: 3;
    align: left middle;
}

.switch-spacer {
    width: 1fr;
    height: 1;
}

.section-label {
    height: 1;
    margin-top: 1;
    color: $primary;
    text-style: bold;
}

.comments-area {
    height: 5;
    margin-bottom: 1;
}

/* ------------------------------------------------------------------- detail */
DeviceDetailScreen {
    align: center middle;
    background: $background;
}

#detail-card {
    width: 94%;
    height: 92%;
    background: $surface;
    border: thick $primary 50%;
    padding: 0 1;
}

#detail-head {
    height: 4;
    border-bottom: solid $primary 20%;
    align: left middle;
}

#detail-head-text {
    width: 1fr;
    height: 4;
    content-align: left middle;
}

#detail-name {
    height: 2;
    text-style: bold;
    color: $foreground;
    content-align: left middle;
}

#detail-meta {
    height: 1;
    color: $text-muted;
}

#detail-status {
    width: auto;
    height: 4;
    padding: 0 2;
    content-align: right middle;
}

.close-button {
    width: 5;
    height: 3;
    min-width: 5;
    border: none;
    background: transparent;
    color: $text-muted;
}

#detail-tabs {
    height: 1fr;
}

#detail-tabs > ContentSwitcher {
    height: 1fr;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    height: 1fr;
    padding: 0 1;
}

.detail-scroll {
    height: 1fr;
}

#detail-overview {
    height: auto;
    padding: 1 1;
}

#detail-events, #detail-sessions {
    height: 1fr;
}

#detail-presence-summary {
    height: auto;
    padding: 1 1;
}

#detail-spark {
    height: 3;
    margin: 1 2;
    color: $primary;
}

#detail-presence-note {
    height: auto;
    padding: 0 2;
}

.detail-tools {
    height: 3;
}

#tool-output {
    height: 1fr;
    background: $panel;
    border: round $primary 15%;
    padding: 0 1;
}

#detail-actions {
    height: 4;
    align: right middle;
    border-top: solid $primary 20%;
    padding-top: 1;
}

#detail-actions Button {
    margin-left: 1;
    min-width: 10;
}

/* ------------------------------------------------------------------- footer */
FooterBar {
    /* 1 line for the top border + 1 line for the hints/meta children. */
    height: 2;
    background: $panel;
    border-top: solid $primary 20%;
    padding: 0 1;
}

#footer-hints {
    width: 1fr;
    height: 1;
    color: $text-muted;
}

#footer-meta {
    width: auto;
    height: 1;
    color: $text-muted;
    content-align: right middle;
}
